<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── Force HTTPS for browsers, but NOT for CLI clients (so `curl show-ip.ir` works) ──
  # Must run BEFORE the clean-URL rules below.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_USER_AGENT} !(curl|wget|httpie|libwww|python-requests|powershell|go-http|okhttp) [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Clean URLs ──
  RewriteRule ^faq/?$ faq.php [L]
  # Blog
  RewriteRule ^blog/?$ blog.php [L,QSA]
  RewriteRule ^blog/([a-z0-9-]+)/?$ blog.php?slug=$1 [L,QSA]
  # RSS feed
  RewriteRule ^feed/?$ rss.php [L]
  RewriteRule ^en/feed/?$ rss.php?lang=en [L,QSA]
  # English version
  RewriteRule ^en/faq/?$ faq.php?lang=en [L,QSA]
  RewriteRule ^en/blog/?$ blog.php?lang=en [L,QSA]
  RewriteRule ^en/blog/([a-z0-9-]+)/?$ blog.php?lang=en&slug=$1 [L,QSA]
  RewriteRule ^en/?$ index.php?lang=en [L,QSA]
  # CLI / API endpoints:  /ip  and  /json
  RewriteRule ^ip/?$ index.php?format=text [L,QSA]
  RewriteRule ^json/?$ index.php?format=json [L,QSA]
</IfModule>

# Security & performance headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Correct MIME type for woff2 (older servers)
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
