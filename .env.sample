# Get your API key(s) from https://ipdata.co
# One or more keys, comma-separated. The site automatically switches to the
# next key when one runs out of quota or gets rate-limited.
IPDATA_API_KEYS=

# Legacy single-key alias (optional; merged into IPDATA_API_KEYS)
API_KEY=

# Optional
APP_NAME=Show-IP.ir
APP_URL=https://show-ip.ir
APP_AUTHOR=Mostafa Mousavi
APP_AUTHOR_URL=https://mousavi.dev

# Set to false only if your server does not have a valid CA bundle (not recommended)
IPDATA_VERIFY_SSL=true
IPDATA_TIMEOUT=15
# Seconds to cache each IP lookup on disk (0 disables). Cuts quota use and latency.
IPDATA_CACHE_TTL=1800
